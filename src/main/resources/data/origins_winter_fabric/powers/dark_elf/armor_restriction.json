          },
          {
            "type": "origins:play_sound",
            "sound": "minecraft:block.anvil.land",
            "volume": 0.4,
            "pitch": 1.2
          },
          {
            "type": "origins:execute_command",
            "command": "particle minecraft:large_smoke ~ ~1 ~ 0.5 0.5 0.5 0.01 5 normal @s"
          }
        ]
      }
