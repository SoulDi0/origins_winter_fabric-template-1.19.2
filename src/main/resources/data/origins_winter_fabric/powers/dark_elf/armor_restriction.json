{
  "type": "origins:multiple",
  "diamond_restriction": {
    "type": "origins:action_over_time",
    "interval": 20,
    "entity_action": {
      "type": "origins:if_else",
      "condition": {
        "type": "origins:or",
        "conditions": [
          {
            "type": "origins:equipped_item",
            "equipment_slot": "head",
            "item_condition": {
              "type": "origins:or",
              "conditions": [
                {
                  "type": "origins:ingredient",
                  "ingredient": {
                    "item": "minecraft:diamond_helmet"
                  }
                },
                {
                  "type": "origins:ingredient",
                  "ingredient": {
                    "item": "minecraft:netherite_helmet"
                  }
                }
              ]
            }
          },
          {
            "type": "origins:equipped_item",
            "equipment_slot": "chest",
            "item_condition": {
              "type": "origins:or",
              "conditions": [
                {
                  "type": "origins:ingredient",
                  "ingredient": {
                    "item": "minecraft:diamond_chestplate"
                  }
                },
                {
                  "type": "origins:ingredient",
                  "ingredient": {
                    "item": "minecraft:netherite_chestplate"
                  }
                }
              ]
            }
          },
          {
            "type": "origins:equipped_item",
            "equipment_slot": "legs",
            "item_condition": {
              "type": "origins:or",
              "conditions": [
                {
                  "type": "origins:ingredient",
                  "ingredient": {
                    "item": "minecraft:diamond_leggings"
                  }
                },
                {
                  "type": "origins:ingredient",
                  "ingredient": {
                    "item": "minecraft:netherite_leggings"
                  }
                }
              ]
            }
          },
          {
            "type": "origins:equipped_item",
            "equipment_slot": "feet",
            "item_condition": {
              "type": "origins:or",
              "conditions": [
                {
                  "type": "origins:ingredient",
                  "ingredient": {
                    "item": "minecraft:diamond_boots"
                  }
                },
                {
                  "type": "origins:ingredient",
                  "ingredient": {
                    "item": "minecraft:netherite_boots"
                  }
                }
              ]
            }
          }
        ]
      },
      "if_action": {
        "type": "origins:and",
        "actions": [
          {
            "type": "origins:execute_command",
            "command": "effect give @s minecraft:slowness 2 2 true"
          },
          {
            "type": "origins:execute_command",
            "command": "effect give @s minecraft:mining_fatigue 2 1 true"
          },
          {
            "type": "origins:execute_command",
            "command": "particle minecraft:ash ~ ~1 ~ 0.3 0.5 0.3 0.02 10 normal @s"
          }
        ]
      },
      "else_action": {
        "type": "origins:and",
        "actions": [
          {
            "type": "origins:execute_command",
            "command": "effect clear @s minecraft:slowness"
          },
          {
            "type": "origins:execute_command",
            "command": "effect clear @s minecraft:mining_fatigue"
          }
        ]
      }
    }
  },
