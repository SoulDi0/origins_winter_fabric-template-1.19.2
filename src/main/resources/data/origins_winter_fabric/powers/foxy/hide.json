{
  "type": "origins:multiple",
  "toggle": {
    "type": "origins:toggle",
    "active_by_default": false,
    "key": "key.origins.secondary_active"
  },
  "invisibility": {
    "type": "origins:invisibility",
    "render_armor": false,
    "condition": {
      "type": "origins:power_active",
      "power": "*:*_toggle"
    }
  },
  "hunger": {
    "type": "origins:exhaust",
    "interval": 20,
    "exhaustion": 3,
    "condition": {
      "type": "origins:power_active",
      "power": "*:*_toggle"
    }
  },
  "name": "Скрытность",
  "description": "Ваша проворность позволяет вам мгновенно исчезать из виду, становясь невидимым, но эта способность требует значительных энергетических затрат и вызывает сильный голод."
}