    "entity_action": {
      "type": "origins:delay",
      "ticks": 3,
      "action": {
        "type": "origins:if_else",
        "condition": {
          "type": "origins:command",
          "command": "execute if entity @e[type=item,distance=..3,limit=1,sort=nearest,tag=!ore_fortune]",
          "comparison": ">=",
          "compare_to": 1
        },
        "if_action": {
          "type": "origins:chance",
          "chance": 0.05,
          "action": {
            "type": "origins:and",
            "actions": [
              {
                "type": "origins:execute_command",
                "command": "execute at @s run summon item ~ ~ ~ {Item:{id:\"minecraft:stone\",Count:1b},PickupDelay:0,Tags:[\"ore_fortune\"]}"
              },
              {
                "type": "origins:execute_command",
                "command": "execute at @s run data modify entity @e[type=item,tag=ore_fortune,limit=1,sort=nearest] Item set from entity @e[type=item,distance=..3,limit=1,sort=nearest,tag=!ore_fortune] Item"
              },
              {
                "type": "origins:execute_command",
                "command": "execute at @s run tag @e[type=item,tag=ore_fortune,limit=1,sort=nearest] remove ore_fortune"
              }
            ]
          }
        }
      }
    }
