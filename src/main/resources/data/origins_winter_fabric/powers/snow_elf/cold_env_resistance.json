{
  "name": "Cold Immunity",
  "description": "As a snow elf, you are completely immune to cold environments.",
  "type": "origins:multiple",
  "freeze_immune": {
    "type": "origins:invulnerability",
    "damage_condition": {
      "type": "origins:name",
      "name": "freeze"
    }
  },
  "recheck_resistance": {
    "type": "origins:action_over_time",
    "entity_action": {
      "type": "origins:execute_command",
      "command": "environment affection @s cold false"
    },
    "interval": 300
  },
  "add_remove": {
    "type": "origins:action_on_callback",
    "entity_action_lost": {
      "type": "origins:execute_command",
      "command": "environment affection @s cold true"
    },
    "entity_action_added": {
      "type": "origins:execute_command",
      "command": "environment affection @s cold false"
    }
  }
}