{
	"schemaVersion": 1,
	"id": "origins_winter_fabric",
	"version": "${version}",
	"name": "Origins Winter Fabric",
	"description": "Добавляет расу Снежного Эльфа, совместимую с Medieval Origins",
	"authors": [
		"SoulDi"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/origins_winter_fabric/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.souldi.origins_winter_fabric.Origins_Winter_Fabric"
		],
		"client": [
			"com.souldi.origins_winter_fabric.Origins_Winter_FabricClient"
		],
		"fabric-datagen": [
			"com.souldi.origins_winter_fabric.Origins_Winter_FabricDataGenerator"
		]
	},
	"mixins": [
		"origins_winter_fabric.mixins.json",
		{
			"config": "origins_winter_fabric.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.14.6",
		"minecraft": "~1.19.2",
		"java": ">=17",
		"fabric-api": "*",
		"origins": "*",
		"medievalorigins": "*",
		"pehkui": "*",
		"environmentz": "*"
	},
	"suggests": {
		"another-mod": "*"
	}
}